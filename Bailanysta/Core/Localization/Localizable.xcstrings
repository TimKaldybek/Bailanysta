        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бізге айтыңыз — біз әрқашан күтеміз ❓"
          }
        }
      }
    },
    "Notification.7.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's new today?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
