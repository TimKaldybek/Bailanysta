        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біз бұл бөлім үстінде белсенді жұмыс істеп жатырмыз. Жақын арада дайын болады — қызығушылығыңыз үшін рахмет! ;)"
          }
        }
      }
