        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жарыңыздың көңіл-күйі қалай? ❤️"
          }
        }
      }
    },
    "Notification.4.Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get to know each other even better tonight 🔥"
