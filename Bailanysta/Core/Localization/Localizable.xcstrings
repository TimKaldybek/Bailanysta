    "Notification.1.Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come on in — we're always here to listen 💬"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заходите — мы всегда рады выслушать 💬"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кіріңіз — біз әрқашан тыңдауға дайынбыз 💬"
          }
        }
      }
    },
    "Notification.1.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got something to share?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть чем поделиться?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлісетін нәрсе бар ма?"
          }
        }
      }
    },
    "Notification.2.Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your thoughts, we're always waiting ✨"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь мыслями, мы всегда ждём ✨"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ойларыңызбен бөлісіңіз, біз әрқашан күтеміз ✨"
          }
        }
      }
    },
    "Notification.2.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How was your day?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как прошёл день?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күніңіз қалай өтті?"
          }
        }
      }
    },
    "Notification.3.Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let it out — we're here to listen 🌙"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выговоритесь — здесь вас услышат 🌙"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүрегіңізді босатыңыз — біз тыңдаймыз 🌙"
          }
        }
      }
    },
    "Notification.3.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something on your mind?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накопилось что сказать?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айтқыңыз келетін нәрсе бар ма?"
          }
        }
      }
    },
    "Notification.4.Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop by and share what's on your mind 💫"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загляните и поделитесь тем, что на душе 💫"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кіріп, көңіліңіздегімен бөлісіңіз 💫"
          }
        }
      }
    },
    "Notification.4.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new day, new thoughts"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый день — новые мысли"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа күн — жаңа ойлар"
          }
        }
      }
    },
    "Notification.5.Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We're always here, come say hi 🎯"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы всегда рядом, заходите 🎯"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біз әрқашан осындамыз, кіріңіз 🎯"
          }
        }
      }
    },
    "Notification.5.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feel like talking it out?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хочется выговориться?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көңіліңізді жеңілдеткіңіз келе ме?"
          }
        }
      }
    },
    "Notification.6.Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share everything that's built up today 🕯️"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь тем, что накопилось за день 🕯️"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күн бойы жиналған ойларыңызбен бөлісіңіз 🕯️"
          }
        }
      }
    },
    "Notification.6.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got a minute?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть минутка?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір минутыңыз бар ма?"
          }
        }
      }
    },
    "Notification.7.Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us — we're always here ❓"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажите нам — мы всегда ждём ❓"
