    "Tip.1.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice the «6-second kiss» today. Research shows it's long enough to release oxytocin and create a moment of genuine connection."
          }
        }
      }
    },
    "Tip.10.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give your partner a genuine compliment about something they often overlook about themselves."
          }
        }
      }
    },
    "Tip.11.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch more intentionally today — a hand on the shoulder, a longer hug, a gentle touch when passing by."
          }
        }
      }
    },
    "Tip.12.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share a memory that made you fall in love with your partner. Say it out loud."
          }
        }
      }
    },
    "Tip.13.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surprise your partner with their favorite snack or drink today. Small gestures build big love."
          }
        }
      }
    },
    "Tip.14.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask: «What would make next week better for you?» and actually help make it happen."
          }
        }
      }
    },
    "Tip.15.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before going to sleep tonight, tell your partner one thing you're grateful for about them."
          }
        }
      }
    },
    "Tip.2.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your phones away for one hour tonight. Give each other your full, undivided attention — no screens, just presence."
          }
        }
      }
    },
    "Tip.3.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask your partner: «What's one small thing I do that makes you feel loved?» Then do more of it."
          }
        }
      }
    },
    "Tip.4.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a text to your partner right now listing three things you love about them. Send it before you put your phone down."
          }
        }
      }
    },
    "Tip.5.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try the 'appreciation ritual' tonight: each of you shares one moment from today when your partner made you feel good."
          }
        }
      }
    },
    "Tip.6.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan a five-minute walk together after dinner — no phones, no agenda. Just walk and talk."
          }
        }
      }
    },
    "Tip.7.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say 'I love you' in a different way today — through an action, a note, or something you cook."
          }
        }
      }
    },
    "Tip.8.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask your partner: «What's one dream you haven't told me yet?» Then just listen."
          }
        }
      }
    },
    "Tip.9.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recreate your very first date tonight — same food, same music, same energy."
          }
        }
      }
    }
  },
  "version": "1.0"
}
