    "Notification.1.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When did you last have a heart-to-heart? 💬"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы в последний раз говорили по душам? 💬"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы рет жүректен-жүрекке сөйлескеніңіз қашан? 💬"
          }
        }
      }
    },
    "Notification.2.Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An evening full of fun and discovery awaits 🌙"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас ждёт вечер, полный веселья и открытий 🌙"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сізді қызық пен жаңалыққа толы кеш күтіп тұр 🌙"
          }
        }
      }
    },
    "Notification.2.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play with your other half tonight 🎲"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сыграйте сегодня вечером со своей половинкой 🎲"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгін кешке жарыңызбен ойнаңыз 🎲"
          }
        }
      }
    },
    "Notification.3.Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One question can bring you closer than you think 💫"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один вопрос может сблизить вас больше, чем вы думаете 💫"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір сұрақ сізді ойлағаннан да жақындата алады 💫"
          }
        }
      }
    },
    "Notification.3.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How is your other half feeling? ❤️"
